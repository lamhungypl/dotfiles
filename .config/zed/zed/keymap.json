// Zed keymap — aligned with VSCode (vim mode)
[
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": ["workspace::SendKeystrokes", "escape"]
    }
  },
  {
    // VSCodeVim-like H/L: VSCodeVim jumps to the last (partially) visible line,
    // so VSCode scrolls to reveal it and repeating keeps scrolling (~5 lines
    // observed). Emulate: screen top/bottom + 5 lines. Native Zed H/L stop at the edge.
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "shift-h": ["action::Sequence", ["vim::WindowTop", ["workspace::SendKeystrokes", "5 k"]]],
      "shift-l": ["action::Sequence", ["vim::WindowBottom", ["workspace::SendKeystrokes", "5 j"]]]
    }
  },
  {
    // VSCode: vim.mode == 'Normal' || vim.mode == 'Visual'
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "; w": "workspace::Save",
      "; e": "project_panel::ToggleFocus",
      "; r": "pane::DeploySearch",
      "; f": "file_finder::Toggle",
      "; d": "pane::CloseInactiveItems",
      "; o": "outline_panel::ToggleFocus",
      "; g": "git_graph::Open",
      "alt-n alt-p": "workspace::ActivatePreviousPane",
      "alt-n alt-n": "workspace::ActivateNextPane",
      "ctrl-shift-alt-=": "vim::ResizePaneRight",
      "ctrl-shift-alt--": "vim::ResizePaneLeft",

      // Zed-only extras (not in VSCode). NOTE: these shadow vim's
      // `t{char}`, `s` and `n` (next search match) — a single `t`/`s`/`n`
      // now waits for the keymap timeout before running.
      "t n": "pane::ActivateNextItem",
      "t p": "pane::ActivatePreviousItem",
      "s v": "pane::SplitRight",
      "s h": "pane::SplitDown",
      "n p": ["workspace::ActivatePaneInDirection", "Left"],
      "n n": ["workspace::ActivatePaneInDirection", "Right"]
    }
  },
  {
    // No file open → no Editor context, so the `;` bindings above don't fire
    "context": "EmptyPane",
    "bindings": {
      "; e": "project_panel::ToggleFocus",
      "; f": "file_finder::Toggle",
      "; r": "pane::DeploySearch",
      "; o": "outline_panel::ToggleFocus",
      "; g": "git_graph::Open"
    }
  },
  {
    // VSCode explorer: a/r/c/p/d (filesExplorerFocus && !inputFocus)
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "r": "project_panel::Rename",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "d": ["project_panel::Delete", { "skip_prompt": false }],
      "; f": "file_finder::Toggle",
      "; r": "pane::DeploySearch",
      "; e": "project_panel::ToggleFocus",
      "; g": "git_graph::Open",
      // pane actions don't reach the panel: jump back to the editor, then run `; d` there
      "; d": ["workspace::SendKeystrokes", "; e ; d"],
      "ctrl-n": "project_panel::NewFile",
      "cmd-n": "project_panel::NewFile",
      "alt-cmd-n": "project_panel::NewDirectory"
    }
  },
  {
    // Terminal has no normal mode, so a bare `;` prefix would hijack shell
    // typing (`a; b`). Use ctrl-; as the prefix instead.
    "context": "Terminal",
    "bindings": {
      "ctrl-; f": "file_finder::Toggle",
      "ctrl-; r": "pane::DeploySearch",
      "ctrl-; e": "project_panel::ToggleFocus",
      "ctrl-; g": "git_graph::Open",
      // pane actions target the editor: jump back to it, then run `; d` there
      "ctrl-; d": ["action::Sequence", ["terminal_panel::ToggleFocus", ["workspace::SendKeystrokes", "; d"]]]
    }
  },
  {
    // Empty pane (no file open) has no Editor context, so the `;` editor
    // bindings above never fire there. Nothing is typed in an empty pane,
    // so a bare `;` prefix is safe.
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      "; f": "file_finder::Toggle",
      "; r": "pane::DeploySearch",
      "; e": "project_panel::ToggleFocus",
      "; g": "git_graph::Open"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-cmd-n": "project_panel::NewDirectory"
    }
  }
]
